{
  "app": "WORDWAVE 单词声波站",
  "version": "2026-11-27-static-demo.1",
  "mode": "github-pages-static",
  "description": "五年级自然拼读 + WORD LAB + 48 音标 + 拍照 OCR；GitHub Pages 静态演示，账号/付费/后台代码完整保留，改用 Node 模式即可启用",
  "entrypoint": "index.html",
  "server": {
    "cwd": ".",
    "command": "python3 -m http.server ${PORT} --bind 0.0.0.0",
    "defaultPort": 8765,
    "alternativeCommand": "py -3 -m http.server ${PORT} --bind 0.0.0.0",
    "requires": [
      "python3"
    ],
    "build": "none",
    "staticEntry": "http://127.0.0.1:8765/?static=1"
  },
  "fullMode": {
    "description": "Node 完整模式：账号、会员付费、管理后台、学习时长统计、按成员隔离和云同步",
    "command": "node server/index.js",
    "npmScript": "npm start",
    "defaultPort": 8787,
    "requires": [
      "node>=22.5"
    ],
    "envFile": ".env.example",
    "dataDir": "data",
    "database": "data/wordwave.db",
    "healthcheck": "/api/health",
    "adminPath": "/admin",
    "seedCommand": "npm run create-admin -- --username admin --password '<至少8位密码>'",
    "test": "npm test"
  },
  "accounts": {
    "codeRetained": true,
    "activeInStaticMode": false,
    "activeInFullMode": true,
    "pricing": {
      "monthly": {
        "priceCents": 500,
        "periodDays": 30,
        "label": "月卡 ¥5 / 30 天"
      },
      "lifetime": {
        "priceCents": 3900,
        "label": "买断 ¥39 / 永久"
      }
    },
    "paymentModes": [
      "manual",
      "mock"
    ],
    "defaultPaymentMode": "manual",
    "sessionCookie": "HttpOnly; SameSite=Lax",
    "csrf": "x-csrf-token for non-GET except login/register"
  },
  "counts": {
    "phonicsGroups": 42,
    "phonicsWords": 840,
    "textbookWords": 44,
    "labWords": 80,
    "labTextbookWords": 44,
    "labExtensionWords": 36,
    "wordAudioFiles": 840,
    "sentenceAudioFiles": 920,
    "uiAudioFiles": 10,
    "channelSentenceAudioFiles": 840,
    "ipaPhonemes": 48,
    "ipaAudioFiles": 48,
    "ipaWords": 240,
    "ipaWordAudioFiles": 163,
    "ocrDictEntries": 57841,
    "ocrFormEntries": 32412,
    "ocrEngineFiles": 6
  },
  "checks": [
    "test -f index.html",
    "test -f account.js",
    "test -f account.css",
    "test -f admin.html",
    "test -f admin.js",
    "test -f admin.css",
    "test -f server/app.js",
    "test -f test/server.test.js",
    "test -f data.js",
    "test -f ipa.js",
    "test -f lab.js",
    "test -f manifest.json",
    "test -f sw.js",
    "find audio/words -type f | wc -l  # 840",
    "find audio/lab/sentences -type f | wc -l  # 80",
    "find audio/sentences -type f | wc -l  # 840",
    "curl -fsS 'http://127.0.0.1:8765/?static=1' >/dev/null",
    "curl -fsS http://127.0.0.1:8765/manifest.json >/dev/null",
    "curl -fsS http://127.0.0.1:8765/audio/words/unhappy.mp3 -o /dev/null",
    "curl -fsS http://127.0.0.1:8765/audio/lab/sentences/unhappy.mp3 -o /dev/null",
    "curl -fsS http://127.0.0.1:8765/audio/sentences/unhappy.mp3 -o /dev/null",
    "find audio/ipa -maxdepth 1 -type f | wc -l  # 48",
    "find audio/ipa/words -type f | wc -l  # 163",
    "test -f ocr-dict.json",
    "test -f ocr-forms.json",
    "test -f vendor/tesseract/tesseract.min.js",
    "test -f vendor/tesseract/lang/eng.traineddata.gz",
    "find vendor/tesseract -type f | wc -l  # 6"
  ],
  "storageKeys": [
    "wordwave.progress.v1",
    "wordwave.wordlab.v1",
    "wordwave.zoom.v1",
    "wordwave.ipa.v1",
    "wordwave.browse.v1",
    "wordwave.ocr.v1",
    "wordwave.ocr.history.v1"
  ],
  "storageNamespacing": {
    "staticMode": "不使用用户前缀，进度只保存在当前浏览器",
    "fullMode": "ww.u<userId>.<key>，由 account.js 在登录后切换",
    "deviceLevelKeys": [
      "wordwave.zoom.v1"
    ]
  },
  "doNotModify": [
    "data.js",
    "lab.js",
    "ipa.js",
    "audio/",
    "account.js",
    "account.css",
    "admin.html",
    "admin.js",
    "admin.css",
    "server/",
    "ocr-dict.json",
    "ocr-forms.json",
    "vendor/"
  ],
  "doNotCopy": [
    ".oil-ui/",
    "work/",
    "shots/",
    "reviews/",
    "node_modules/",
    "data/",
    ".env",
    "*.log"
  ],
  "notes": [
    "当前 GitHub Pages 是静态演示：打开 ?static=1 或 github.io 域名时自动进入，不登录、不收费、不云同步",
    "账号管理逻辑没有删除：account.js、server/、admin.*、test/ 都保留；npm start 即启用完整模式",
    "静态模式的进度使用原始 localStorage 键，不会写入任何成员账号",
    "不要在 GitHub Pages 上收真实付款；真实收款必须部署 Node 模式并使用 manual/mock 支付流程",
    "Python 只用于静态预览，不能提供账号、支付、后台和学习统计",
    "PWA 安装需要 HTTPS；局域网 HTTP 只能浏览"
  ],
  "pwa": {
    "manifest": "manifest.json",
    "serviceWorker": "sw.js",
    "offlineShell": true,
    "runtimeAudioCache": true,
    "installRequiresHttps": true,
    "icons": "icons/",
    "bypassCache": [
      "/api/",
      "/admin",
      "/admin.html"
    ]
  }
}
