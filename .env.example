# WORDWAVE server configuration. Copy to .env and edit.
# Never commit .env or the data/ directory.

# HTTP
HOST=0.0.0.0
PORT=8788
# Set to 1 when the site is served over HTTPS (or behind an HTTPS reverse proxy).
COOKIE_SECURE=0
# Set to 1 only if a trusted reverse proxy sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=0

# Storage
DATA_DIR=data
# Study time is attributed to this timezone's calendar day.
APP_TIMEZONE=Asia/Shanghai
# Hard cap per user per day (minutes), protects statistics from forged heartbeats.
STUDY_DAILY_CAP_MINUTES=720

# Payments: manual | mock
#   manual - user places an order, pays by transfer, admin confirms in /admin
#   mock   - orders can be paid instantly for local testing; do NOT use in production
PAYMENT_MODE=manual

# Initial administrator. If no administrator exists at first startup, these
# credentials are used. If they are empty, a random password is generated and
# written to data/initial-admin.txt (mode 0600); read it once, then delete it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: session lifetime in days (default 30)
SESSION_DAYS=30
